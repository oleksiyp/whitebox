# whitebox split: file selection, the two segmenters, groups/windows, cost estimate (port of cmdSplit of whitebox.mjs).
# Environment: WB_MODE (git|walk|files) WB_LIST (file with one path per line) WB_TOTAL WB_ROOT WB_WORK WB_WIN WB_MAXKB WB_INCL
#              WB_EXCL WB_TESTS WB_CFG WB_SHA WB_TMP

BEGIN {
  initcommon()
  MODE = ENVIRON["WB_MODE"]; WORK = ENVIRON["WB_WORK"]; WIN = ENVIRON["WB_WIN"] + 0; MAX = 80
  ROOT = ENVIRON["WB_ROOT"]; SHA = ENVIRON["WB_SHA"]; TMPD = ENVIRON["WB_TMP"]
  initconst()
  loadlist()
  if (MODE != "files") selectProject(); else { for (i = 1; i <= NR_; i++) { INC[++NINC] = RELS[i]; INCABS[NINC] = RELS[i] } }
  if (MODE == "files") findroot()
  sortincluded()
  segmentAll()
  report()
  exit 0
}

function initconst(   a, n, i) {
  n = split("go:go ts:ts tsx:tsx js:js jsx:jsx mjs:js cjs:js py:py rs:rust java:java kt:kotlin c:c h:c cc:cpp cpp:cpp hpp:cpp cs:csharp rb:ruby php:php swift:swift sh:sh bash:sh sql:sql proto:proto star:starlark lua:lua scala:scala ex:elixir exs:elixir dart:dart", a, " ")
  for (i = 1; i <= n; i++) { split(a[i], kv, ":"); CODEEXT[kv[1]] = kv[2] }
  n = split("yaml yml json toml ini tf tpl cfg conf xml", a, " "); for (i = 1; i <= n; i++) CFGEXT[a[i]] = 1
  n = split("node_modules vendor dist build out target coverage __pycache__ venv site-packages bower_components testdata fixtures __snapshots__ golden third_party generated", a, " "); for (i = 1; i <= n; i++) SKIPDIRS[a[i]] = 1
  n = split("go.sum package-lock.json yarn.lock pnpm-lock.yaml cargo.lock poetry.lock gemfile.lock composer.lock bun.lockb", a, " "); for (i = 1; i <= n; i++) LOCKS[a[i]] = 1
  n = split("func type class def fn pub impl struct enum trait interface const var let export import package module use async public private protected static abstract final namespace template extern mod object data sealed open", a, " "); for (i = 1; i <= n; i++) DECLW[a[i]] = 1
  WSC = "[ \t\r\f\013]"
  MAXKB = (ENVIRON["WB_MAXKB"] == "" ? 300 : ENVIRON["WB_MAXKB"] + 0)
  WITHTESTS = ENVIRON["WB_TESTS"] == "1"; WITHCFG = ENVIRON["WB_CFG"] == "1"
  nincl = globs(ENVIRON["WB_INCL"], INCL); nexcl = globs(ENVIRON["WB_EXCL"], EXCL)
}
function globs(s, out,   a, n, i, k) {
  k = 0; n = split(s, a, ",")
  for (i = 1; i <= n; i++) if (a[i] != "") out[++k] = globre(a[i])
  return k
}
function globre(g,   i, c, o, n) {
  g = trim(g); o = "^"; n = length(g); i = 1
  while (i <= n) {
    c = substr(g, i, 1)
    if (c == "*") { if (substr(g, i + 1, 1) == "*") { o = o ".*"; i += 2 } else { o = o "[^/]*"; i++ } continue }
    if (c == "?") { o = o "[^/]"; i++; continue }
    if (index(".+^${}()|[]\\", c) > 0) o = o "\\" c; else o = o c
    i++
  }
  return o "$"
}
function anyglob(G, n, rel,   i) { for (i = 1; i <= n; i++) if (rel ~ G[i]) return 1; return 0 }

function loadlist(   f, line) {
  f = ENVIRON["WB_LIST"]; NR_ = 0
  while ((getline line < f) > 0) RELS[++NR_] = line
  close(f)
  TOTAL = ENVIRON["WB_TOTAL"] + 0
}

# ---------------- file selection ----------------
function skip(rel, why) {
  if (!(why in RCNT)) { RCNT[why] = 0; RORD[++NRS] = why; NSAMP[why] = 0 }
  RCNT[why]++
  if (NSAMP[why] < 3) RSAMP[why, ++NSAMP[why]] = rel
}
function finfo(abs,   cmd, a, b, lim) {
  cmd = "wc -c < " shq(abs) "; head -c 4096 < " shq(abs) " | tr -d '\\000' | wc -c"
  a = 0; b = 0
  cmd | getline a; cmd | getline b; close(cmd)
  FSZ = a + 0; lim = FSZ < 4096 ? FSZ : 4096
  FNUL = (b + 0 < lim)
}
function genheader(abs,   line, acc, n, tot) {
  acc = ""; n = 0; tot = 0
  while (n < 6 && tot < 600 && (getline line < abs) > 0) { acc = acc line "\n"; tot += length(line) + 1; n++ }
  close(abs)
  acc = tolower(substr(acc, 1, 600))
  return acc ~ /(code generated|do not edit|@generated|autogenerated|auto-generated|<auto-generated|generated file)/
}
function selectProject(   i, rel, np, P, name, ext, forced, parts, k, kind, rl, nd, abs, dot) {
  for (i = 1; i <= NR_; i++) {
    rel = RELS[i]; np = split(rel, P, "/"); name = P[np]
    dot = 0; for (k = length(name); k > 0; k--) if (substr(name, k, 1) == ".") { dot = k; break }
    ext = dot ? tolower(substr(name, dot + 1)) : ""
    forced = anyglob(INCL, nincl, rel)
    if (anyglob(EXCL, nexcl, rel)) { skip(rel, "excluded by --exclude"); continue }
    abs = ROOT "/" rel
    if (!forced) {
      nd = 0; for (k = 1; k <= np; k++) if (substr(P[k], 1, 1) == ".") nd = 1
      if (nd) { skip(rel, "hidden file or directory"); continue }
      nd = 0; for (k = 1; k < np; k++) if (P[k] in SKIPDIRS) nd = 1
      if (nd) { skip(rel, "generated / vendored / fixture directory"); continue }
      rl = tolower(rel)
      if (rl ~ /(^|\/)(\.env[^\/]*|[^\/]*\.(pem|key|p12|pfx|jks|keystore|kdbx|crt|cer|asc)|id_(rsa|dsa|ecdsa|ed25519)[^\/]*|[^\/]*(secret|credential|password|passwd|token)s?[^\/]*\.(json|ya?ml|toml|ini|txt|env|conf|cfg)|\.?netrc|\.npmrc|\.pypirc|[^\/]*\.tfstate(\.backup)?|[^\/]*\.tfvars)$/) { skip(rel, "looks like a secret or key file (never sent to a model; use --include to override)"); continue }
      if (tolower(name) in LOCKS) { skip(rel, "lockfile"); continue }
      if (name ~ /\.min\.|\.map$/) { skip(rel, "minified / sourcemap"); continue }
      kind = (ext == "md" || ext == "markdown") ? "doc" : ((ext in CODEEXT) ? "code" : ((ext in CFGEXT) ? "config" : ""))
      if (kind == "") { skip(rel, "other file type (binary, media, text data)"); continue }
      if (kind == "config" && !WITHCFG) { skip(rel, "config file (add --config to include)"); continue }
      if (kind == "code" && !WITHTESTS && rel ~ /(_test\.go$|\.test\.[a-z]+$|\.spec\.[a-z]+$|(^|\/)(tests?|__tests__|e2e)\/|(^|\/)test_[^\/]*\.py$|_test\.py$|Test\.java$|Tests?\.cs$)/) { skip(rel, "test file (add --tests to include)"); continue }
      finfo(abs)
      if (kind != "doc" && FSZ > MAXKB * 1024) { skip(rel, "source file larger than " MAXKB " KB (add --max-kb or --include)"); continue }
      if (kind == "doc" && FSZ > 8 * 1024 * 1024) { skip(rel, "markdown larger than 8 MB"); continue }
    } else finfo(abs)
    if (FNUL) { skip(rel, "binary"); continue }
    if (!forced && genheader(abs)) { skip(rel, "generated code header"); continue }
    INC[++NINC] = rel; INCABS[NINC] = abs
  }
}

function findroot(   i, ok, r) {
  ROOT = dirnamep(INCABS[1])
  while (1) {
    ok = 1
    for (i = 1; i <= NINC; i++) if (substr(INCABS[i], 1, length(ROOT) + 1) != ROOT "/") ok = 0
    if (ok || ROOT == "/") break
    ROOT = dirnamep(ROOT)
  }
  for (i = 1; i <= NINC; i++) INC[i] = relativep(ROOT, INCABS[i])
}

# bytewise, ASCII-lowercase, stable sort of the included files
function sortincluded(   i, f, cmd, line, k, tmpl, tmpo, ord, n, a) {
  tmpl = TMPD "/sortin"; tmpo = TMPD "/sortout"
  printf "" > tmpl
  for (i = 1; i <= NINC; i++) print tolower(INC[i]) "\t" i > tmpl
  close(tmpl)
  cmd = "sort -t '\t' -k1,1 -k2,2n < " shq(tmpl)
  k = 0
  while ((cmd | getline line) > 0) { n = split(line, a, "\t"); ORDI[++k] = a[n] + 0 }
  close(cmd)
  for (i = 1; i <= NINC; i++) { SREL[i] = INC[ORDI[i]]; SABS[i] = INCABS[ORDI[i]] }
}

# ---------------- text helpers shared by the segmenters ----------------
function clean(s,   o, m, p) {
  o = ""
  while (match(s, /[`*_]|\[[^]]*\]\([^)]*\)/)) {
    o = o substr(s, 1, RSTART - 1); m = substr(s, RSTART, RLENGTH)
    if (substr(m, 1, 1) == "[") { p = index(m, "]"); o = o substr(m, 2, p - 2) }
    s = substr(s, RSTART + RLENGTH)
  }
  s = o s
  gsub(/[ \t\r\n\f\013]+/, " ", s)
  return trim(s)
}
function txt(s, e,   t, i) { t = L[s]; for (i = s + 1; i <= e; i++) t = t "\n" L[i]; return t }
function CL(i) { return i == 1 ? L1c : L[i] }
function CBL(i) { return i == 1 ? CB1 : BL[i] }

function isHeading(l) { return l ~ /^ ? ? ?#(#?#?#?#?#?)[ \t\r\f\013]+[^ \t\r\f\013]/ }
function isFence(l) { return l ~ /^ ? ? ?(```|~~~)/ }
function isList(l) { return l ~ /^ ? ? ?([-*+]|[0-9][.)]|[0-9][0-9][.)]|[0-9][0-9][0-9][.)])[ \t\r\f\013]+/ }
function isTable(l) { return l ~ /^[ \t\r\f\013]*\|/ }
function startsWS(l) { return l ~ /^[ \t\r\f\013]/ }

# ---------------- packing (splitUnit / pack) ----------------
function splitUnit(us, ue, max, code,   cs, acc, lb, i, lw, brk, e, k) {
  SUn = 0
  if (PW[ue] - PW[us - 1] <= max) { SUs[1] = us; SUe[1] = ue; SUn = 1; return }
  cs = us; acc = 0; lb = 0
  for (i = us; i <= ue; i++) {
    lw = WL[i]
    if (code && BL[i] && acc >= max / 3) lb = i
    if (acc > 0 && acc + lw > max && !BL[i]) {
      brk = i; if (code && lb && lb > cs) brk = lb + 1
      e = brk - 1; while (BL[e]) e--
      SUn++; SUs[SUn] = cs; SUe[SUn] = e; cs = brk; lb = 0
      acc = 0; for (k = cs; k <= i; k++) acc += WL[k]
      continue
    }
    acc += lw
  }
  e = ue; while (BL[e]) e--
  SUn++; SUs[SUn] = cs; SUe[SUn] = e
}
# pack the run of units RUs[]/RUe[] (RUn of them) and emit pieces via emit()
function pack(max, small, code, hp,   u, k, s, e, w, has, cs, ce, cw) {
  has = 0
  for (u = 1; u <= RUn; u++) {
    splitUnit(RUs[u], RUe[u], max, code)
    for (k = 1; k <= SUn; k++) {
      s = SUs[k]; e = SUe[k]; w = PW[e] - PW[s - 1]
      if (has && (cw < small || w < small) && cw + w <= max) { ce = e; cw += w }
      else { if (has) emit(cs, ce, cw, hp, code); cs = s; ce = e; cw = w; has = 1 }
    }
  }
  if (has) emit(cs, ce, cw, hp, code)
  RUn = 0
}
function emit(s, e, w, hp, code,   i, sn, a, n, c, j, t) {
  NP++
  PC_f[NP] = CURF; PC_s[NP] = s; PC_e[NP] = e; PC_w[NP] = w; PC_hp[NP] = hp
  if (code) {
    PC_k[NP] = "c"; PC_lang[NP] = LANG
    sn = ""; c = 0
    for (i = s; i <= e && c < 10; i++) if (!BL[i]) {
      t = trim(L[i]); sn = sn (c ? " \342\217\216 " : "") ucut(t, 100); c++
    }
    PC_sn[NP] = sn
  } else {
    PC_k[NP] = ""; PC_lang[NP] = ""
    t = clean(txt(s, e))
    if (t == "") sn = ""
    else { n = split(t, a, " "); sn = a[1]; for (j = 2; j <= n && j <= 18; j++) sn = sn " " a[j]; if (n > 18) sn = sn " \342\200\246" }
    PC_sn[NP] = sn
  }
}

# ---------------- markdown segmenter ----------------
function mdPieces(   i, l, m3, j, lvl, k, t, hl, hp, rest, e, nx) {
  hl = 0; hp = ""; RUn = 0; i = 1
  while (i <= n) {
    l = CL(i)
    if (CBL(i)) { i++; continue }
    if (isFence(l)) {
      t = l; sub(/^ +/, "", t); m3 = substr(t, 1, 3)
      j = i + 1
      while (j <= n && substr(trim(CL(j)), 1, 3) != m3) j++
      RUn++; RUs[RUn] = i; RUe[RUn] = (j < n ? j : n); i = j + 1; continue
    }
    if (isHeading(l)) {
      t = l; sub(/^ +/, "", t); match(t, /^#+/); lvl = RLENGTH; t = substr(t, lvl + 1)
      sub(/^[ \t\r\n\f\013]+/, "", t); sub(/[ \t\r\n\f\013]+$/, "", t); sub(/#+$/, "", t); sub(/[ \t\r\n\f\013]+$/, "", t)
      pack(MAX, 20, 0, hp)
      while (hl > 0 && HLV[hl] >= lvl) hl--
      hl++; HLV[hl] = lvl; HRW[hl] = clean(t)
      hp = HRW[1]; for (k = 2; k <= hl; k++) hp = hp " > " HRW[k]
      i++; continue
    }
    if (isTable(l)) {
      j = i; while (j + 1 <= n && isTable(CL(j + 1))) j++
      RUn++; RUs[RUn] = i; RUe[RUn] = j; i = j + 1; continue
    }
    if (isList(l)) {
      j = i
      while (j < n) {
        nx = CL(j + 1)
        if (CBL(j + 1)) {
          k = j + 1; while (k <= n && CBL(k)) k++
          if (k <= n && CL(k) ~ /^(  +|\t)[^ \t\r\f\013]/ && !isHeading(CL(k))) { j = k; continue }
          break
        }
        if (isHeading(nx) || (isFence(nx) && !startsWS(nx)) || (isList(nx) && nx !~ /^  /) || substr(nx, 1, 1) == "|") break
        j++
      }
      RUn++; RUs[RUn] = i; RUe[RUn] = j; i = j + 1; continue
    }
    j = i
    while (j < n && !CBL(j + 1) && !isHeading(CL(j + 1)) && !isFence(CL(j + 1)) && !isList(CL(j + 1)) && !isTable(CL(j + 1))) j++
    RUn++; RUs[RUn] = i; RUe[RUn] = j; i = j + 1
  }
  pack(MAX, 20, 0, hp)
}

# ---------------- code segmenter ----------------
function leadingword(l) { if (match(l, /^[A-Za-z0-9_]+/)) return substr(l, 1, RLENGTH); return "" }
function isLead(l,   r) {
  if (substr(l, 1, 2) == "//" || substr(l, 1, 2) == "/*") return 1
  if (substr(l, 1, 1) == "#") {
    r = substr(l, 2)
    if (startswith(r, "include") || startswith(r, "define") || startswith(r, "if") || startswith(r, "endif") || startswith(r, "pragma") || substr(r, 1, 1) == "!") return 0
    return 1
  }
  if (substr(l, 1, 2) == "--") return 1
  if (l ~ /^@[A-Za-z_(]/) return 1
  return 0
}
function bal(l,   s, k, i, o, c, r2, j, d, t) {
  s = l
  if (inBlock) { k = index(s, "*/"); if (k == 0) return 0; s = substr(s, k + 2); inBlock = 0 }
  if (!PY) {
    o = ""
    while ((i = index(s, "/*")) > 0) {
      r2 = substr(s, i + 2); j = index(r2, "*/")
      if (j == 0) break
      o = o substr(s, 1, i - 1); s = substr(r2, j + 2)
    }
    s = o s
    k = index(s, "/*"); if (k > 0) { inBlock = 1; s = substr(s, 1, k - 1) }
  }
  gsub(/"(\\.|[^"\\])*"|'(\\.|[^'\\])*'|`[^`]*`/, "", s)
  if (PY) { k = index(s, "#"); if (k > 0) s = substr(s, 1, k - 1) }
  else { k = index(s, "//"); if (k > 0) s = substr(s, 1, k - 1) }
  t = s; o = gsub(/[[({]/, "", t); c = gsub(/[])}]/, "", t)
  return o - c
}
function codeUnits(   i, l, col0, depth, chain, blankSince, cs, ce, has, lw, closer, lead) {
  depth = 0; inBlock = 0; has = 0; chain = 0; blankSince = 0; RUn = 0
  for (i = 1; i <= n; i++) {
    l = CL(i)
    if (CBL(i)) { blankSince = 1; continue }
    col0 = !startsWS(l)
    if (col0 && !inBlock) {
      lw = leadingword(l)
      if (lw in DECLW) depth = 0
      lead = isLead(l)
      closer = (substr(l, 1, 1) == "}" || substr(l, 1, 1) == ")" || substr(l, 1, 1) == "]") || (LANG == "py" && (lw == "else" || lw == "elif" || lw == "except" || lw == "finally"))
      if (depth <= 0 && !closer && !(chain && !blankSince)) {
        if (has) { RUn++; RUs[RUn] = cs; RUe[RUn] = ce }
        cs = i; ce = i; has = 1
      }
      chain = lead
    } else if (!col0) chain = 0
    depth += bal(l); if (depth < 0) depth = 0
    if (!has) { cs = i; ce = i; has = 1 }
    ce = i; blankSince = 0
  }
  if (has) { RUn++; RUs[RUn] = cs; RUe[RUn] = ce }
}

# ---------------- split driver ----------------
function sha1file(abs,   cmd, line, a, k, n, r) {
  cmd = SHA " < " shq(abs); r = ""
  while ((cmd | getline line) > 0) { n = split(line, a, /[ =()]+/); for (k = 1; k <= n; k++) if (length(a[k]) == 40 && a[k] ~ /^[0-9a-f]+$/) r = a[k] }
  close(cmd)
  return r
}
function segmentAll(   fi, abs, rel, raw, ext, dot, k, i, bom, first, w) {
  NP = 0; NF = 0
  for (fi = 1; fi <= NINC; fi++) {
    abs = SABS[fi]; rel = SREL[fi]
    raw = slurp(abs)
    if (!SL_OK) { print "ERROR: cannot read " abs > "/dev/stderr"; exit 1 }
    n = jsplit(raw, L)
    if (L[n] == "") n--
    dot = 0; for (k = length(rel); k > 0; k--) if (substr(rel, k, 1) == ".") { dot = k; break }
    ext = tolower(dot ? substr(rel, dot + 1) : rel)
    LANG = (ext in CODEEXT) ? CODEEXT[ext] : ""
    PW[0] = 0
    for (i = 1; i <= n; i++) { BL[i] = isblank(L[i]); WL[i] = BL[i] ? 0 : W(L[i]); PW[i] = PW[i - 1] + WL[i] }
    L1c = (n >= 1) ? L[1] : ""
    if (substr(L1c, 1, 3) == "\357\273\277") L1c = substr(L1c, 4)
    CB1 = isblank(L1c)
    first = NP + 1; CURF = fi - 1
    if (LANG != "") {
      PY = (LANG == "py" || LANG == "sh" || LANG == "ruby")
      codeUnits(); pack(200, 40, 1, "")
    } else mdPieces()
    NF++
    F_rel[NF] = rel; F_bytes[NF] = length(raw); F_first[NF] = first; F_last[NF] = NP; F_lang[NF] = (LANG != "" ? LANG : "md"); F_h[NF] = sha1file(abs)
  }
}

# ---------------- output ----------------
function jarr(a, n, ind,   i, s) { return "" }
function report(   i, k, by, nby, kk, langs, nl, f, ord, tmp, j, why, o, line, tn, fam, nfam, famk, famb, last, key, total, M, g, G, nG, gfrom, gto, ws, we, best, x, fl, tf, left, need, cum, bytes, nw, longest, est, cmdname) {
  # selection report
  if (MODE != "files") {
    nl = 0
    for (i = 1; i <= NF; i++) { if (!(F_lang[i] in by)) { by[F_lang[i]] = 0; langs[++nl] = F_lang[i] } by[F_lang[i]]++ }
    line = "  included: "
    for (i = 1; i <= nl; i++) line = line (i > 1 ? ", " : "") by[langs[i]] " " langs[i]
    printf "selection (%s): %d of %d files included\n", (MODE == "git" ? "git: tracked + untracked, honouring .gitignore" : "directory walk"), NINC, TOTAL
    print line
    # sort reasons by count descending, ties in first-seen order
    for (i = 1; i <= NRS; i++) ord[i] = i
    for (i = 2; i <= NRS; i++) { x = ord[i]; j = i - 1; while (j >= 1 && RCNT[RORD[ord[j]]] < RCNT[RORD[x]]) { ord[j + 1] = ord[j]; j-- } ord[j + 1] = x }
    for (i = 1; i <= NRS; i++) {
      why = RORD[ord[i]]; line = ""
      for (k = 1; k <= NSAMP[why]; k++) line = line (k > 1 ? ", " : "") RSAMP[why, k]
      printf "  skipped %s  %s   e.g. %s\n", padstart(RCNT[why], 4), why, line
    }
    sel = WORK "/selection.json"
    printf "{\n \"included\": [" > sel
    for (i = 1; i <= NF; i++) printf "%s\n  %s", (i > 1 ? "," : ""), jstr(F_rel[i]) > sel
    printf "%s],\n \"reasons\": {", (NF ? "\n " : "") > sel
    for (i = 1; i <= NRS; i++) printf "%s\n  %s: %d", (i > 1 ? "," : ""), jstr(RORD[i]), RCNT[RORD[i]] > sel
    printf "%s},\n \"samples\": {", (NRS ? "\n " : "") > sel
    for (i = 1; i <= NRS; i++) {
      why = RORD[i]; printf "%s\n  %s: [", (i > 1 ? "," : ""), jstr(why) > sel
      for (k = 1; k <= NSAMP[why]; k++) printf "%s\n   %s", (k > 1 ? "," : ""), jstr(RSAMP[why, k]) > sel
      printf "\n  ]" > sel
    }
    printf "%s}\n}", (NRS ? "\n " : "") > sel
    close(sel)
  }
  if (NP == 0) { print "ERROR: nothing to analyse: no pieces were found in the selected files (see the skipped counts above; try --tests, --config or --include)" > "/dev/stderr"; exit 1 }
  # families: name-2, name-3 stay together
  nfam = 0
  for (i = 1; i <= NF; i++) {
    key = F_rel[i]
    if (match(key, /-[0-9]+\.([Mm][Dd]|[Mm][Aa][Rr][Kk][Dd][Oo][Ww][Nn])$/)) { tn = substr(key, RSTART); sub(/^-[0-9]+/, "", tn); key = substr(key, 1, RSTART - 1) tn }
    if (nfam > 0 && famk[nfam] == key) { famlast[nfam] = i } else { nfam++; famk[nfam] = key; famfirst[nfam] = i; famlast[nfam] = i }
    famb[nfam] += F_bytes[i]
  }
  total = 0; for (i = 1; i <= nfam; i++) total += famb[i]
  M = int(sqrt(NF)); if (nfam < M) M = nfam; if (M < 1) M = 1
  nG = 0; cum = 0; gfam1 = 1
  for (i = 1; i <= nfam; i++) {
    cum += famb[i]
    left = nfam - i; need = M - nG - 1
    if (nG < M - 1 && (cum >= total * (nG + 1) / M || left <= need)) { nG++; GF1[nG] = famfirst[gfam1]; GF2[nG] = famlast[i]; gfam1 = i + 1 }
  }
  if (gfam1 <= nfam) { nG++; GF1[nG] = famfirst[gfam1]; GF2[nG] = famlast[nfam] }
  # windows
  nw = 0; longest = -1
  for (g = 1; g <= nG; g++) {
    gfrom = F_first[GF1[g]]; gto = F_last[GF2[g]]; GFROM[g] = gfrom; GTO[g] = gto
    bytes = 0; for (i = GF1[g]; i <= GF2[g]; i++) bytes += F_bytes[i]; GB[g] = bytes
    NWG[g] = 0; ws = gfrom
    while (ws <= gto) {
      we = ws + WIN - 1; if (we > gto) we = gto
      if (we < gto) {
        best = -1
        for (i = GF1[g]; i <= GF2[g]; i++) {
          x = F_last[i]
          if (x >= ws + WIN * 0.7 && x <= (gto < ws + WIN * 1.3 ? gto : ws + WIN * 1.3)) {
            if (best == -1 || abs_(x - (ws + WIN - 1)) < abs_(best - (ws + WIN - 1))) best = x
          }
        }
        if (best != -1) we = best
      }
      NWG[g]++; WF[g, NWG[g]] = ws; WT[g, NWG[g]] = we; ws = we + 1
    }
    nw += NWG[g]; if (NWG[g] > longest) longest = NWG[g]
  }
  # pieces.json / groups.json
  pj = WORK "/pieces.json"
  printf "{\"root\":%s,\"files\":[\n", jstr(ROOT) > pj
  for (i = 1; i <= NF; i++) printf "{\"rel\":%s,\"bytes\":%d,\"first\":%d,\"last\":%d,\"lang\":%s,\"h\":%s}%s\n", jstr(F_rel[i]), F_bytes[i], F_first[i], F_last[i], jstr(F_lang[i]), jstr(F_h[i]), (i < NF ? "," : "") > pj
  printf "],\"pieces\":[\n" > pj
  for (i = 1; i <= NP; i++) {
    printf "{\"i\":%d,\"f\":%d,\"s\":%d,\"e\":%d,\"w\":%d,\"hp\":%s", i, PC_f[i], PC_s[i], PC_e[i], PC_w[i], jstr(PC_hp[i]) > pj
    if (PC_k[i] == "c") printf ",\"k\":\"c\",\"lang\":%s", jstr(PC_lang[i]) > pj
    printf ",\"sn\":%s}%s\n", jstr(PC_sn[i]), (i < NP ? "," : "") > pj
  }
  printf "]}\n" > pj
  close(pj)
  gj = WORK "/groups.json"
  if (nG == 0) printf "[]" > gj
  else {
    printf "[" > gj
    for (g = 1; g <= nG; g++) {
      printf "%s\n {\n  \"g\": %d,\n  \"files\": [", (g > 1 ? "," : ""), g > gj
      for (i = GF1[g]; i <= GF2[g]; i++) printf "%s\n   %s", (i > GF1[g] ? "," : ""), jstr(F_rel[i]) > gj
      printf "\n  ],\n  \"bytes\": %d,\n  \"from\": %d,\n  \"to\": %d,\n  \"windows\": [", GB[g], GFROM[g], GTO[g] > gj
      for (k = 1; k <= NWG[g]; k++) printf "%s\n   {\n    \"w\": %d,\n    \"from\": %d,\n    \"to\": %d\n   }", (k > 1 ? "," : ""), k, WF[g, k], WT[g, k] > gj
      printf "\n  ]\n }" > gj
    }
    printf "\n]" > gj
  }
  close(gj)
  printf "%d files, %d pieces -> %d groups\n", NF, NP, nG
  # estimate
  code = 0; for (i = 1; i <= NP; i++) if (PC_k[i] == "c") code++
  agents = round(nw * 1.2 + nG + NP / 150 + 6)
  if (nG == 0) minutes = "-Infinity"; else minutes = round(longest * 3.2 + 6 + (NP / 1500 < 10 ? NP / 1500 : 10))
  tk = int((agents * 6 + 5) / 10); tokens = (tk % 10 == 0) ? sprintf("%d", tk / 10) : sprintf("%d.%d", int(tk / 10), tk % 10)
  ej = WORK "/estimate.json"
  printf "{\"pieces\":%d,\"docPieces\":%d,\"codePieces\":%d,\"windows\":%d,\"groups\":%d,\"agents\":%d,\"tokensM\":%s,\"minutes\":%s}", NP, NP - code, code, nw, nG, agents, tokens, (nG == 0 ? "null" : minutes) > ej
  close(ej)
  printf "estimate: ~%d haiku agents, ~%sM tokens, ~%s min wall-clock (%d doc + %d code pieces, %d windows). Rough: real runs landed within 0.5x-2x.\n", agents, tokens, minutes, NP - code, code, nw
  for (g = 1; g <= nG; g++) printf "  group %d: %d files, %d KB, %d pieces, %d windows\n", g, GF2[g] - GF1[g] + 1, int(GB[g] / 1024), GTO[g] - GFROM[g] + 1, NWG[g]
}
function abs_(x) { return x < 0 ? -x : x }
